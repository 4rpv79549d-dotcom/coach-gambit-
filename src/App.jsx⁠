function remark(pos, i, l) {
  const { san, s } = pos[i];
  if (!san) return x(l, "Начальная позиция. Тут пока никто не ошибся — наслаждайтесь.", "Starting position. Nobody has blundered yet — enjoy it.");
  const side = i % 2 ? x(l, "Белые", "White") : x(l, "Чёрные", "Black");
  if (san.includes("#")) return x(l, `Мат. ${side} ставят точку, остальное — лирика.`, `Checkmate. ${side} put the full stop on it; the rest is poetry.`);
  if (san.startsWith("O-O")) return x(l, `${side} рокируются. Король убрался с дороги — признак здравого смысла.`, `${side} castle. The king gets out of the way — a sign of good sense.`);
  if (san.includes("=")) return x(l, `Превращение! ${side} получили вторую жизнь, как в аркаде.`, `Promotion! ${side} get a second life, arcade style.`);
  const taken = s.cap && pos[i - 1].s.b[s.mv[1]];
  if (taken && taken.toLowerCase() === "q") return x(l, "Ферзь снят с доски. Это либо гениально, либо очень больно.", "The queen comes off the board. Either genius or very painful.");
  if (san.includes("+")) return x(l, `Шах! ${side} напоминают королю, что он не в отпуске.`, `Check! ${side} remind the king he's not on holiday.`);
  if (taken) return x(l, `Размен. Забрали ${PIECE_ACC.ru[taken.toLowerCase()] || "фигуру"}. Проверьте, не осталось ли что-то под боем.`, `A capture — they took ${PIECE_ACC.en[taken.toLowerCase()] || "a piece"}. Check whether anything is left hanging.`);
  if (i === 1) {
    if (san === "e4") return x(l, "1.e4 — классика, как утренний кофе: просто и бодрит.", "1.e4 — the classic. Like morning coffee: simple and invigorating.");
    if (san === "d4") return x(l, "1.d4 — любите, когда всё под контролем? Уважаю.", "1.d4 — fond of having things under control? Respect.");
    return x(l, `1.${san} — нестандартно. Или вы хотели сломать теорию, или она вас.`, `1.${san} — unusual. Either you're breaking theory, or it's about to break you.`);
  }
  return pick(POOL[san[0] in POOL ? san[0] : "P"], i)[l];
}

function greet(op, l) {
  return op
    ? x(l, `Играем «${op}»? Люблю, когда игроки начинают с идеей. Листайте ходы — буду комментировать.`, `Playing the ${op}? I like players who start with an idea. Step through the moves — I'll comment.`)
    : x(l, "Партия загружена. Листайте ходы, а я буду комментировать и подкалывать.", "Game loaded. Step through the moves and I'll comment — and tease.");
}

function classify(q) {
  const t = q.toLowerCase();
  if (/дебют|opening/.test(t)) return "opening";
  if (/ошиб|зевок|плох|blunder|mistake|wrong|bad/.test(t)) return "mistake";
  if (/оцен|позици|лучше|материал|eval|position|better|material|winning/.test(t)) return "eval";
  if (/дальше|совет|план|что делать|next|advice|plan|what should/.test(t)) return "plan";
  return "other";
}

function reply(intent, pos, i, opening, k, l) {
  if (intent === "opening")
    return opening
      ? x(l, `Дебют — «${opening}». Теорию знать полезно, но понимать идеи полезнее: куда идут фигуры и зачем.`, `The opening is the ${opening}. Knowing theory helps, but understanding the ideas helps more: where the pieces go, and why.`)
      : x(l, "Дебют определяется по первым ходам, а здесь заголовок партии молчит. Смотрите на развитие фигур и центр.", "The game header doesn't name the opening, so judge it by piece development and the centre.");
  if (intent === "mistake")
    return pick([
      x(l, "Я бы ткнул в момент, где вы торопились. Пролистайте на пару ходов назад — найдёте сами.", "I'd poke at the moment you were rushing. Step back a couple of moves — you'll spot it yourself."),
      x(l, "Ошибки любят размены, после которых забывают про шах. Проверьте каждое взятие.", "Mistakes love exchanges where everyone forgets about a check. Re-check every capture."),
    ], k);
  if (intent === "eval") {
    const m = material(pos[i].s.b);
    if (m === 0) return x(l, "Материал равный. Значит, всё решат планы и нервы.", "Material is equal. So plans and nerves will decide.");
    const who = m > 0 ? x(l, "белые", "White") : x(l, "чёрные", "Black");
    return x(l, `Материал: ${who} впереди на ${Math.abs(m)}. Но счёт — не приговор, если король соперника без укрытия.`, `Material: ${who} is ahead by ${Math.abs(m)}. But the count isn't a verdict if the opposing king has no shelter.`);
  }
  if (intent === "plan")
    return pick([
      x(l, "Улучшайте худшую фигуру. Скучно, но работает в девяти партиях из десяти.", "Improve your worst piece. Boring, but it works in nine games out of ten."),
      x(l, "Проверьте шахи, взятия и угрозы — в таком порядке. Потом ходите.", "Check checks, captures and threats — in that order. Then move."),
    ], k);
  const san = pos[i].san;
  return pick([
    x(l, `Интересный вопрос. А вы сами что думаете о ходе ${san || "в начальной позиции"}?`, `Interesting question. What do you think of ${san ? "the move " + san : "the starting position"} yourself?`),
    x(l, "Хмм… Я бы сначала посмотрел, какие фигуры у вас ещё не играют.", "Hmm… I'd first look at which of your pieces aren't playing yet."),
    x(l, "Давайте разберём по ходам. Листайте — я буду подкалывать.", "Let's go move by move. Keep stepping — I'll keep teasing."),
  ], k);
}

