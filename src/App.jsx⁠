  const pos = useMemo(() => (sel ? build(sel.pgn) : []), [sel]);
  const opening = useMemo(() => (sel ? openingName(sel.pgn) : ""), [sel]);
  const my = sel && user && sel.black.username.toLowerCase() === user ? "b" : "w";
  const flip = my === "b";

  /* — озвучка — */
  useEffect(() => {
    if (!canSpeak) return;
    const warm = () => window.speechSynthesis.getVoices();
    warm();
    window.speechSynthesis.addEventListener?.("voiceschanged", warm);
    return () => { window.speechSynthesis.removeEventListener?.("voiceschanged", warm); window.speechSynthesis.cancel(); };
  }, []);

  function stopSpeech() {
    if (canSpeak) window.speechSynthesis.cancel();
    setSpeakingKey(null);
  }
  function speak(text, key, l = lang) {
    if (!canSpeak || !text) return;
    const ss = window.speechSynthesis;
    ss.cancel();
    const u = new SpeechSynthesisUtterance(text);
    u.lang = l === "ru" ? "ru-RU" : "en-GB";
    const v = pickVoice(l);
    if (v) { u.voice = v; u.lang = v.lang; }
    u.rate = 1; u.pitch = 1;
    const done = () => setSpeakingKey((k) => (k === key ? null : k));
    u.onend = done; u.onerror = done;
    setSpeakingKey(key);
    ss.speak(u);
  }
  // iPhone: «разблокировка» речи внутри жеста пользователя, чтобы ответы с задержкой тоже озвучивались
  function unlock() {
    if (!canSpeak) return;
    const u = new SpeechSynthesisUtterance(" ");
    u.volume = 0;
    window.speechSynthesis.speak(u);
  }
  function tapSpeak(text, key) {
    if (speakingKey === key) stopSpeech();
    else speak(text, key);
  }
  function toggleSound() {
    if (!canSpeak) return;
    if (sound) { setSound(false); stopSpeech(); }
    else { setSound(true); speak(T.soundHello, "hello"); }
  }
  function changeLang(l) {
    if (l === lang) return;
    stopSpeech();
    setLang(l);
  }

  /* — данные Chess.com — */
  const outcome = (g) => {
    const me = g.white.username.toLowerCase() === user ? g.white : g.black, op = me === g.white ? g.black : g.white;
    return me.result === "win" ? "win" : op.result === "win" ? "loss" : "draw";
  };

  async function load() {
    const u = name.trim().toLowerCase();
    if (!u) return;
    setLoading(true); setError(null); setGames(null); setUser(u);
    try {
      const r = await fetch(`https://api.chess.com/pub/player/${encodeURIComponent(u)}/games/archives`);
      if (r.status === 404) throw { k: "notFound" };
      if (!r.ok) throw { k: "api", s: r.status };
      const { archives = [] } = await r.json();
      if (!archives.length) throw { k: "none" };
      let all = [];
      for (const url of archives.slice(-2).reverse()) {
        const res = await fetch(url);
        const j = await res.json();
        all = all.concat((j.games || []).filter((g) => g.pgn).reverse());
        if (all.length >= 10) break;
      }
      setGames(all.slice(0, 10));
    } catch (e) {
      setError(e && e.k ? e : { k: "net" });
    } finally { setLoading(false); }
  }

  function open(g) {
    const op = openingName(g.pgn);
    setSel(g); setIdx(0); setInput(""); setTyping(false);
    setChat([{ f: "coach", kind: "greet", op }]);
    if (sound) speak(greet(op, lang), "c0");
  }

  /* — навигация по ходам (озвучка запускается прямо в обработчике нажатия) — */
  function go(i) {
    const j = Math.max(0, Math.min(pos.length - 1, i));
    if (j === idx) return;
    setIdx(j);
    if (sound) speak(remark(pos, j, lang), "live");
  }
  stepRef.current = (d) => go(idx + d);
  useEffect(() => {
    if (!sel) return;
    const h = (e) => {
      if (e.target.tagName === "INPUT") return;
      if (e.key === "ArrowLeft") stepRef.current(-1);
      if (e.key === "ArrowRight") stepRef.current(1);
    };
    window.addEventListener("keydown", h);
    return () => window.removeEventListener("keydown", h);
  }, [sel]);
  useEffect(() => { if (chatRef.current) chatRef.current.scrollTop = chatRef.current.scrollHeight; }, [chat, typing]);
  useEffect(() => {
    const el = movesRef.current?.querySelector(`[data-i="${idx}"]`);
    if (el) movesRef.current.scrollLeft = el.offsetLeft - movesRef.current.clientWidth / 2;
  }, [idx, sel]);

  /* — чат — */
  const coachText = (m) => (m.kind === "greet" ? greet(m.op, lang) : reply(m.intent, pos, m.at, opening, m.k, lang));

  function send(text, intent) {
    const q = text.trim();
    if (!q || typing) return;
    const msg = { f: "coach", kind: "reply", intent: intent || classify(q), k: chat.length, at: idx };
    const key = `c${chat.length + 1}`;
    setChat((c) => [...c, { f: "me", t: q }]);
    setInput(""); setTyping(true);
    if (sound) unlock();
    setTimeout(() => {
      setChat((c) => [...c, msg]);
      setTyping(false);
      if (sound) speak(reply(msg.intent, pos, msg.at, opening, msg.k, lang), key);
    }, 700);
  }

  const SpeakBtn = ({ text, k, big }) =>
    canSpeak ? (
      <button onClick={() => tapSpeak(text, k)} aria-label={speakingKey === k ? T.stop : T.listen}
        className={`shrink-0 rounded-full ${big ? "p-2" : "p-2.5"} transition ${speakingKey === k ? "bg-amber-400 text-slate-900" : "bg-slate-800 text-slate-300 hover:text-amber-300"}`}>
        <Volume2 size={big ? 16 : 15} className={speakingKey === k ? "animate-pulse" : ""} />
      </button>
    ) : null;

  const Player = ({ g, side }) => {
    const p = side === "w" ? g.white : g.black;
    return (
      <div className="flex items-center gap-2 px-1 py-1.5 text-sm">
        <span className={`h-3.5 w-3.5 rounded-sm border ${side === "w" ? "bg-stone-100 border-stone-300" : "bg-slate-950 border-slate-600"}`} />
        <span className="font-medium text-slate-100">{p.username}</span>
        {p.rating !== "" && <span className="text-slate-400">{p.rating}</span>}
      </div>
    );
  };

  const liveText = sel ? remark(pos, idx, lang) : "";

  return (
    <div className="min-h-screen bg-slate-950 text-slate-200">
      <div className="mx-auto w-full max-w-md px-4 pb-10 pt-6">
        <header className="mb-5 flex items-center gap-2.5">
          <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-400 text-slate-900"><Crown size={22} /></div>
          <div className="min-w-0 flex-1">
            <h1 className="truncate text-lg font-semibold leading-tight text-white" style={{ fontFamily: "Georgia, serif" }}>{T.title}</h1>
            <p className="truncate text-xs text-slate-400">{T.sub}</p>
          </div>
          <div role="group" aria-label={T.langAria} className="flex shrink-0 overflow-hidden rounded-lg border border-slate-700 text-xs font-semibold">
            {["ru", "en"].map((l) => (
              <button key={l} onClick={() => changeLang(l)} aria-pressed={lang === l}
                className={`px-2.5 py-2.5 ${lang === l ? "bg-amber-400 text-slate-900" : "bg-slate-900 text-slate-300 hover:text-white"}`}>
                {l.toUpperCase()}
              </button>
            ))}
          </div>
          <button onClick={toggleSound} disabled={!canSpeak} aria-label={!canSpeak ? T.soundNo : sound ? T.soundOn : T.soundOff} aria-pressed={sound}
            className={`shrink-0 rounded-lg border p-2.5 transition disabled:opacity-40 ${sound ? "border-amber-400 bg-amber-400 text-slate-900" : "border-slate-700 bg-slate-900 text-slate-300 hover:text-white"}`}>
            {sound ? <Volume2 size={18} /> : <VolumeX size={18} />}
          </button>
        </header>

        {!sel && (
          <>
            <div className="rounded-2xl border border-slate-800 bg-slate-900 p-4">
              <label className="mb-2 block text-sm text-slate-300">{T.nick}</label>
              <div className="flex gap-2">
                <input value={name} onChange={(e) => setName(e.target.value)} onKeyDown={(e) => e.key === "Enter" && load()}
                  placeholder={T.ph} autoCapitalize="none" autoCorrect="off"
                  className="min-w-0 flex-1 rounded-xl border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white placeholder-slate-500 outline-none focus:border-amber-400" />
                <button onClick={load} disabled={loading || !name.trim()}
                  className="flex items-center gap-1.5 rounded-xl bg-amber-400 px-4 text-sm font-semibold text-slate-900 transition hover:bg-amber-300 disabled:opacity-40">
                  {loading ? <Loader2 size={16} className="animate-spin" /> : <Search size={16} />} {T.find}
                </button>
              </div>
              {error && (
                <div className="mt-3 flex gap-2 rounded-xl bg-rose-500/10 p-3 text-sm text-rose-300">
                  <AlertTriangle size={16} className="mt-0.5 shrink-0" />
                  <span>{typeof T.e[error.k] === "function" ? T.e[error.k](error.s) : T.e[error.k]}</span>
                </div>
              )}
              <button onClick={() => { setUser(""); open(DEMO); }} className="mt-3 flex items-center gap-1.5 text-sm text-slate-400 hover:text-amber-300">
                <Play size={14} /> {T.demo}
              </button>
            </div>

            {games && (
              <div className="mt-5">
                <h2 className="mb-2 px-1 text-sm text-slate-400">{T.recent} · {games.length}</h2>
                {games.length === 0 && <p className="px-1 text-sm text-slate-500">{T.none}</p>}
                <ul className="space-y-2">
                  {games.map((g, i) => {
                    const mine = g.white.username.toLowerCase() === user ? g.white : g.black, op = mine === g.white ? g.black : g.white, o = outcome(g);
                    return (
                      <li key={i}>
                        <button onClick={() => open(g)} className="flex w-full items-center gap-3 rounded-xl border border-slate-800 bg-slate-900 p-3 text-left transition hover:border-amber-400/60">
                          <span className={`h-4 w-4 shrink-0 rounded-sm border ${mine === g.white ? "bg-stone-100 border-stone-300" : "bg-slate-950 border-slate-600"}`} />
                          <span className="min-w-0 flex-1">
                            <span className="block truncate text-sm font-medium text-white">{op.username} <span className="font-normal text-slate-400">{op.rating}</span></span>
                            <span className="flex items-center gap-1 text-xs text-slate-500"><Clock size={11} />{g.time_class} · {new Date(g.end_time * 1000).toLocaleDateString(T.locale, { day: "numeric", month: "short" })}</span>
                          </span>
                          <span className={`rounded-lg px-2 py-1 text-xs font-medium ${RES_STYLE[o]}`}>{T.res[o]}</span>
                        </button>
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}
          </>
        )}

        {sel && (
          <div>
            <button onClick={() => { stopSpeech(); setSel(null); }} className="mb-3 flex items-center gap-1.5 text-sm text-slate-400 hover:text-white"><ArrowLeft size={16} /> {T.back}</button>
            {opening && <p className="mb-2 px-1 text-sm text-amber-300">{opening}</p>}
            <Player g={sel} side={flip ? "w" : "b"} />
            <Board s={pos[idx].s} flip={flip} />
            <Player g={sel} side={flip ? "b" : "w"} />

            <div className="mt-2 flex items-center gap-2">
              <button onClick={() => go(0)} aria-label={T.first} className="rounded-xl bg-slate-900 p-3 text-slate-300 hover:bg-slate-800"><ChevronsLeft size={18} /></button>
              <button onClick={() => go(idx - 1)} className="flex flex-1 items-center justify-center gap-1 rounded-xl bg-slate-800 py-3 text-sm font-medium text-white hover:bg-slate-700"><ChevronLeft size={18} /> {T.prev}</button>
              <button onClick={() => go(idx + 1)} className="flex flex-1 items-center justify-center gap-1 rounded-xl bg-amber-400 py-3 text-sm font-semibold text-slate-900 hover:bg-amber-300">{T.next} <ChevronRight size={18} /></button>
              <button onClick={() => go(pos.length - 1)} aria-label={T.last} className="rounded-xl bg-slate-900 p-3 text-slate-300 hover:bg-slate-800"><ChevronsRight size={18} /></button>
            </div>

            <div ref={movesRef} className="relative mt-3 flex gap-1 overflow-x-auto pb-2">
              {pos.slice(1).map((p, k) => {
                const i = k + 1;
                return (
                  <button key={i} data-i={i} onClick={() => go(i)}
                    className={`shrink-0 rounded-lg px-2 py-1 text-xs ${i === idx ? "bg-amber-400 font-semibold text-slate-900" : "bg-slate-900 text-slate-300 hover:bg-slate-800"}`}>
                    {i % 2 ? `${(i + 1) / 2}. ` : ""}{p.san}
                  </button>
                );
              })}
            </div>

            <div className="mt-3 overflow-hidden rounded-2xl border border-slate-800 bg-slate-900">
              <div className="flex items-start gap-2 border-b border-slate-800 bg-slate-900 p-3 text-sm">
                <Sparkles size={16} className="mt-2.5 shrink-0 text-amber-400" />
                <p className="min-w-0 flex-1 pt-2">
                  <span className="font-semibold text-white">{idx ? T.moveLbl(Math.ceil(idx / 2), pos[idx].san) : T.startLbl}.</span>{" "}
                  <span className="text-slate-300">{liveText}</span>
                </p>
                <SpeakBtn text={liveText} k="live" />
              </div>

              <div ref={chatRef} className="flex h-60 flex-col gap-2 overflow-y-auto p-3">
                {chat.map((m, i) =>
                  m.f === "me" ? (
                    <div key={i} className="max-w-[85%] self-end rounded-2xl rounded-br-md bg-amber-400 px-3 py-2 text-sm text-slate-900">{m.t}</div>
                  ) : (
                    <div key={i} className="flex max-w-[92%] items-end gap-1.5 self-start">
                      <div className="rounded-2xl rounded-bl-md bg-slate-800 px-3 py-2 text-sm text-slate-100">{coachText(m)}</div>
                      <SpeakBtn text={coachText(m)} k={`c${i}`} />
                    </div>
                  )
                )}
                {typing && <div className="self-start rounded-2xl rounded-bl-md bg-slate-800 px-3 py-2 text-sm text-slate-400">{T.think}</div>}
              </div>

              <div className="flex gap-2 overflow-x-auto px-3 pb-2">
                {Object.entries(T.chips).map(([intent, label]) => (
                  <button key={intent} onClick={() => send(label, intent)} className="shrink-0 rounded-full border border-slate-700 px-3 py-1.5 text-xs text-slate-300 hover:border-amber-400 hover:text-amber-300">{label}</button>
                ))}
              </div>
              <div className="flex gap-2 border-t border-slate-800 p-3">
                <input value={input} onChange={(e) => setInput(e.target.value)} onKeyDown={(e) => e.key === "Enter" && send(input)}
                  placeholder={T.ask} className="min-w-0 flex-1 rounded-xl border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white placeholder-slate-500 outline-none focus:border-amber-400" />
                <button onClick={() => send(input)} aria-label={T.send} className="rounded-xl bg-amber-400 px-3 text-slate-900 hover:bg-amber-300"><Send size={16} /></button>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
