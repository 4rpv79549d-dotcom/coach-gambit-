}

/* ───────── Доска ───────── */
const GLYPH = { k: "♚", q: "♛", r: "♜", b: "♝", n: "♞", p: "♟" };
function Board({ s, flip }) {
  const kSq = s.b.indexOf(s.turn === "w" ? "K" : "k");
  const inCheck = kSq >= 0 && attacked(s.b, kSq, s.turn === "w" ? "b" : "w");
  const cells = [];
  for (let d = 0; d < 64; d++) {
    const r = d >> 3, c = d & 7, idx = flip ? 63 - d : d, p = s.b[idx], px = c * 10, py = r * 10;
    cells.push(
      <g key={d}>
        <rect x={px} y={py} width="10" height="10" fill={(r + c) % 2 ? "#6f80ab" : "#d6dae8"} />
        {s.mv && s.mv.includes(idx) && <rect x={px} y={py} width="10" height="10" fill="#fbbf24" opacity="0.55" />}
        {inCheck && idx === kSq && <circle cx={px + 5} cy={py + 5} r="4.6" fill="#ef4444" opacity="0.6" />}
        {c === 0 && <text x={px + 0.7} y={py + 2.6} fontSize="2.3" fill={(r + c) % 2 ? "#d6dae8" : "#6f80ab"} fontWeight="700">{8 - (idx >> 3)}</text>}
        {r === 7 && <text x={px + 9.3} y={py + 9.3} fontSize="2.3" textAnchor="end" fill={(r + c) % 2 ? "#d6dae8" : "#6f80ab"} fontWeight="700">{"abcdefgh"[idx & 7]}</text>}
        {p && (
          <text x={px + 5} y={py + 7.7} fontSize="8.4" textAnchor="middle" paintOrder="stroke" strokeLinejoin="round"
            fontFamily="'Segoe UI Symbol','Noto Sans Symbols 2','DejaVu Sans',serif"
            fill={white(p) ? "#fbf8ef" : "#161820"} stroke={white(p) ? "#14161d" : "#e6e9f4"} strokeWidth={white(p) ? 0.45 : 0.25}>
            {GLYPH[p.toLowerCase()] + "\uFE0E"}
          </text>
        )}
      </g>
    );
  }
  return <svg viewBox="0 0 80 80" className="w-full rounded-xl block shadow-2xl shadow-black/50">{cells}</svg>;
}

