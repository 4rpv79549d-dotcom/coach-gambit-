function pickVoice(l) {
  const vs = window.speechSynthesis.getVoices();
  const n = (v) => v.lang.replace("_", "-").toLowerCase();
  if (l === "ru") return vs.find((v) => n(v) === "ru-ru") || vs.find((v) => n(v).startsWith("ru"));
